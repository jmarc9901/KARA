// Reusable module — only component and function definitions.
// Import with:  import "./widgets.kara"

component Card(title, body) {
  Column {
    padding: 14
    spacing: 8
    Text { value: "📌 ${title}" bold: true fontSize: 17 }
    Text { value: "${body}" }
  }
}

fn max(a, b) {
  if (a > b) { return a }
  return b
}
